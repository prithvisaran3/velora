# Velora — environment variables
# Copy to .env.local for development. In production these are Cloudflare secrets.
# Only NEXT_PUBLIC_* reach the browser. Everything else is server-only.

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://velora.in
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210          # Bharani Pattu WhatsApp Business, no +

# ---------- Firebase (web config — public by design) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase Admin (server only) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=                              # keep \n escapes intact
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080             # dev only, unset in production

# ---------- ImageKit ----------
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/velora
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=                              # server only — signs admin uploads

# ---------- Razorpay (Phase 4) ----------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=                               # server only — signature verification
RAZORPAY_WEBHOOK_SECRET=                           # server only — DIFFERENT from key secret

# ---------- Shiprocket (Phase 5) ----------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Erode
SHIPROCKET_WEBHOOK_TOKEN=

# ---------- Resend (Phase 3) ----------
RESEND_API_KEY=
RESEND_FROM="Velora <orders@velora.in>"

# ---------- Admin ----------
ADMIN_EMAIL=
